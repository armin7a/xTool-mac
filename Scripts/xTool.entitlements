<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox WITHOUT the network entitlement: macOS blocks every network access by xTool. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Only files you pick or drag in yourself (import, backup). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- USB sticks and other drives under /Volumes: the vault can live there. Everything else on the Mac stays closed. -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/Volumes/</string>
    </array>
</dict>
</plist>
